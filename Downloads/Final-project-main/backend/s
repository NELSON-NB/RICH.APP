            return res.status(404).json({ success: false, message: "User not found" });
        }

        res.json({ success: true, message: "User deleted successfully" });
    } catch (error) {
        console.error("Error deleting user:", error);
        res.status(500).json({ success: false, message: "Error deleting user" });
    }
};

export const searchUsers = async (req, res) => {
    try {
        if (!req.user || !req.user.roles.includes("admin")) {
            return res.status(401).json({ success: false, message: "Unauthorized" });
        }

        const { searchTerm } = req.query;
        
        if (!searchTerm) {
            return res.status(400).json({ success: false, message: "Search term is required" });
        }

        const users = await User.find({
            $or: [
                { name: { $regex: searchTerm, $options: 'i' } },
                { email: { $regex: searchTerm, $options: 'i' } }
            ]
        }).select("-password");

        if (!users || users.length === 0) {
            return res.status(404).json({ success: false, message: "No users found" });
        }

        res.json({ success: true, users });
    } catch (error) {
        console.error("Error searching users:", error);
        res.status(500).json({ success: false, message: "Error searching users" });
    }
};

export const getUserStatistics = async (req, res) => {
    try {
        const totalUsers = await User.countDocuments();

        // Aggregate users by day and count new users for each day
        const newUsersToday = await User.aggregate([
            {
                $project: {
                    createdAt: 1,
                    dayCreated: { $dateToString: { format: "%Y-%m-%d", date: "$createdAt" } }
                }
            },
            {
                $match: {
                    dayCreated: { $eq: new Date(new Date().setHours(0, 0, 0, 0)).toISOString().split('T')[0] }
                }
            },
            {
                $count: "newUsersToday"
            }
        ]);

        // If no new users today, set the count to 0
        const newUsersTodayCount = newUsersToday.length > 0 ? newUsersToday[0].newUsersToday : 0;

        // Count active users
        const activeUsers = await User.countDocuments({ isActive: true });

        // Calculate old users
        const oldUsers = totalUsers - newUsersTodayCount;

        res.json({
            success: true,
            statistics: { totalUsers, newUsersToday: newUsersTodayCount, oldUsers, activeUsers }
        });
    } catch (error) {
        console.error("Error fetching user statistics:", error);
        res.status(500).json({ success: false, message: 'Error fetching user statistics' });
    }
};

